DATABASE_URL=postgresql://postgres:your-password@localhost:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-server-secret-or-local-service-role-key
GROQ_API_KEY=your-account-key
GROQ_MODEL=openai/gpt-oss-20b
TRANSCRIPTION_PROVIDER=groq
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
MAX_AUDIO_BYTES=8388608
MAX_AUDIO_SECONDS=120
AUDIO_MIN_RMS=0.003
OBSERVATION_SAMPLE_MS=750
OBSERVATION_SUSTAIN_MS=4000
OBSERVATION_DEBOUNCE_MS=1000
OBSERVATION_RECOVERY_MS=2000
OBSERVATION_COOLDOWN_MS=10000
FACE_MODEL_PATH=/mediapipe/blaze_face_short_range.tflite
FACE_MIN_CONFIDENCE=0.6
VISION_ENABLED=true
VISION_MODEL=qwen/qwen3.8-27b
VISION_INTERVAL_SECONDS=20
VISION_AUDIT_SECONDS=60
VISION_MAX_PER_MINUTE=3
VISION_MAX_PER_DAY=80
VISION_MAX_PER_SESSION=180
VISION_MAX_IMAGE_BYTES=131072
CORS_ORIGINS=["http://localhost:3000"]
RESUME_LIMIT=10
INTERVIEW_LIMIT=3
USAGE_WINDOW_HOURS=24
AI_MAX_TOKENS=4096
GROQ_REASONING_EFFORT=low
AI_INPUT_CHARS=11000
